# Copy to .env and adjust. `.env` is gitignored and must stay that way.
# Never put a real secret in this file — this one IS committed.

# --- Model provider ---------------------------------------------------------
# bedrock (default) | ollama | bedrock+ollama — see app/providers/resolver.py.
# Left as `ollama` here so a fresh clone runs with no AWS account. Deployments
# unset it and take the bedrock default.
KEA_PROVIDER=ollama

# Ollama runs NATIVE on macOS, not in Docker — Docker has no Apple GPU access.
KEA_OLLAMA_MODEL=gemma3:4b
KEA_OLLAMA_URL=http://localhost:11434

# --- AWS / Bedrock (Sprint 3) ----------------------------------------------
# Credentials do NOT go here. Use `aws configure`, SSO, or an instance role.
KEA_BEDROCK_MODEL=
AWS_REGION=ap-southeast-2

# --- Database ---------------------------------------------------------------
# Matches infra/docker-compose.yml. Change the password for anything shared.
# The +asyncpg driver is required — the app uses SQLAlchemy's async engine and
# asyncpg is the only Postgres driver in pyproject.toml. `+psycopg` will fail.
KEA_DATABASE_URL=postgresql+asyncpg://kea:kea@localhost:5432/kea

# --- API --------------------------------------------------------------------
# Comma-separated. The frontend dev server's origin.
KEA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (services/web) ------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code. Never put a
# secret behind a VITE_ prefix — it is compiled into the bundle and shipped.
VITE_API_BASE_URL=http://localhost:8000

# --- Voice (ADR-0003) -------------------------------------------------------
# Off by default. `./ml/voice/setup.sh` builds the stack and prints these values
# with the correct absolute paths for your machine — paste its output over these.
#
# Voice needs a SECURE CONTEXT in the browser. localhost qualifies; http://192.168.x.x
# does not, and getUserMedia fails silently there (KEA-55). Demo from the host machine
# or put mkcert in front of it.
KEA_VOICE_ENABLED=0
KEA_WHISPER_BIN=
KEA_WHISPER_MODEL=
KEA_PIPER_BIN=
KEA_PIPER_VOICE=
KEA_SILERO_VAD_MODEL=

# --- Alert delivery ---------------------------------------------------------
# One backend per channel. All default to `file`, which writes a real message to
# var/outbox/<channel>/ and needs no account, no card and no network. See
# app/alerts/channels.py for what each free tier actually gives you.
#
#   KEA_EMAIL_BACKEND   file | smtp | resend
#   KEA_SMS_BACKEND     file | textbelt | twilio
#   KEA_VOICE_BACKEND   file | twilio
#
# The university AWS account cannot use SES, SNS or Connect, which is why these
# are third parties. An SesGateway drops into the same protocol when that changes.
KEA_EMAIL_BACKEND=file
KEA_SMS_BACKEND=file
KEA_VOICE_BACKEND=file

# Resend: 3,000 emails/month free. Without a verified sender domain it only accepts
# onboarding@resend.dev as the from-address, and that sender delivers ONLY to the
# address the account was registered with — a send to anyone else returns 403.
KEA_RESEND_API_KEY=

# Textbelt: ONE free message per day per IP. `textbelt` is the documented free key,
# not a placeholder. Quota exhaustion returns HTTP 200 with success:false.
KEA_TEXTBELT_KEY=textbelt

# Twilio: trial credit, and it only delivers to numbers verified in the console.
# A trial account accepts a send to an unverified number and fails it asynchronously,
# so a 201 does not mean the phone buzzed — check the SID on the alert row.
KEA_TWILIO_ACCOUNT_SID=
KEA_TWILIO_AUTH_TOKEN=
KEA_TWILIO_FROM_NUMBER=

# Fallback contact points for households with no preference row. A real deployment
# leaves these empty and reads the address off app.alert_preference, which correctly
# reports "no address on file" rather than mailing the operator about a stranger.
KEA_DEMO_PHONE=
