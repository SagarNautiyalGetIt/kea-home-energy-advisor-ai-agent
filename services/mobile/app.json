{
  "expo": {
    "name": "Kea Energy",
    "slug": "kea-energy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kea/kea-profile.png",
    "scheme": "keaenergy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/kea/kea-profile.png",
      "supportsTablet": true,
      "bundleIdentifier": "nz.co.keaenergy.mobile"
    },
    "android": {
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F4F7FF",
        "foregroundImage": "./assets/kea/kea-profile.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "nz.co.keaenergy.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/kea/kea-profile.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7FF",
          "image": "./assets/kea/kea-profile.png",
          "imageWidth": 160
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kea Energy to use your approximate location once to suggest an Auckland demo area. Kea does not save or send your coordinates.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "enableOpenCLAndHexagon": false,
          "forceCxx20": true
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
