# Public base URL only. Never place secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=https://api.example.com

# Optional path overrides. Defaults shown below.
EXPO_PUBLIC_REGISTER_PATH=/api/auth/register
EXPO_PUBLIC_FORGOT_PASSWORD_PATH=/api/auth/password/forgot
EXPO_PUBLIC_CHANGE_PASSWORD_PATH=/api/auth/password/change
EXPO_PUBLIC_REFRESH_TOKEN_PATH=/api/auth/refresh
EXPO_PUBLIC_PROFILE_PATH=/api/households/{customer_id}/profile
EXPO_PUBLIC_BILLING_PATH=/api/households/{customer_id}/billing
EXPO_PUBLIC_PLANS_PATH=/api/households/{customer_id}/plans
EXPO_PUBLIC_PLAN_SWITCH_PATH=/api/households/{customer_id}/plan-switch
EXPO_PUBLIC_NOTIFICATION_PREFERENCES_PATH=/api/households/{customer_id}/notification-preferences
EXPO_PUBLIC_PUSH_TOKEN_PATH=/api/households/{customer_id}/push-tokens
EXPO_PUBLIC_PAYMENT_PATH=/api/households/{customer_id}/payments
EXPO_PUBLIC_PAYMENT_METHODS_PATH=/api/households/{customer_id}/payment-methods
EXPO_PUBLIC_AI_FEEDBACK_PATH=/api/chat/feedback
EXPO_PUBLIC_AI_ATTACHMENT_PATH=/api/households/{customer_id}/chat/attachments
EXPO_PUBLIC_VOICE_PATH=/api/voice/stream

# Expo project identifier used to issue device push tokens.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Card data is sent directly to the PCI-compliant provider for tokenization.
# The mobile app sends only the returned token to Kea's backend.
EXPO_PUBLIC_PAYMENT_TOKENIZATION_URL=https://payments.example.com/tokenize
EXPO_PUBLIC_PAYMENT_PUBLIC_KEY=provider-publishable-key
