# Public base URL only. Never place secrets in EXPO_PUBLIC_* variables.
# Leave blank for localhost on iOS/web or 10.0.2.2 on the Android emulator.
# On a physical phone, set this to the Kea API's reachable LAN origin.
EXPO_PUBLIC_API_URL=

# Live backend is the default. Set false only for an explicitly labelled UI preview.
EXPO_PUBLIC_USE_REAL_DATA=true

# Optional HTTPS model origin. Blank retains the upstream URL and pinned size/hash.
EXPO_PUBLIC_PHONE_MODEL_URL=

# Contact profile edits, plan requests, feedback, private attachments and opt-in
# push registration use the canonical API routes. Registration/password reset
# require identity-provider setup. Card payment/saved cards remain HTTP 501 until
# a retailer payment provider is selected; no card details are collected.
