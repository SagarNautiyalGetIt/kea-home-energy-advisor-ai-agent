# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Node / frontend --------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Generated --------------------------------------------------------------
*.db
# NOTE: contracts/openapi.json is deliberately COMMITTED, not ignored. It is the
# contract between backend and frontend — the frontend team must be able to
# generate types without standing up Postgres and the API first. Regenerate it
# with `make api-spec` in the same PR as any endpoint change.
services/web/src/api.d.ts

# --- Terraform / infra state ------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# --- Secrets — never commit -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials
.aws/

# --- OS / editor junk -------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- AI tool configs — never commit -----------------------------------------
# These are local developer tool configurations, not project source material.
.claude/
CLAUDE.md
AGENTS.md
.hyperframes/
hyperframes.json
.copilot/
.cursor/
.aider*
.codeium/

# --- Vault leakage guard ----------------------------------------------------
# This repo lives inside an Obsidian vault directory tree. Nothing belonging to
# the vault may ever be committed. See the absolute rule in CONTRIBUTING.md.
.obsidian/
.trash/
*.canvas

# --- Coursework, not project material ---------------------------------------
# The internship journal and its supporting documents are the author's own
# coursework, submitted to the academic supervisor. They are not Kea Energy
# project files, so under the rule in CONTRIBUTING.md they do not belong here.
data/journal/

# --- Raw source extracts -----------------------------------------------------
# data/raw/ holds source data as received. The LCL smart-meter dataset alone is
# about 1 GB zipped, and the rule in data/README.md is that raw extracts are
# never edited by hand -- so they are fetched, not committed. The fetch script
# records provenance and a checksum alongside them.
data/raw/*
!data/raw/.gitkeep
# Derived from raw/lcl by cohort.py; ~1 MB, rebuilt in a minute.
data/pipeline/scripts/gen_source/coverage.json

# Rootless local Postgres cluster (infra/pg-local.sh) — never commit a data directory.
.pg-local/

# Generated alert emails (app/alerts/email.py FileSender). Real messages with real
# recipient addresses in them — an artefact of running the demo, never source.
var/
services/api/var/
# Local model daemon log (infra/ollama.sh). Runtime output, not source.
.ollama.log
